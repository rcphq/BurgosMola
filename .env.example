# --- Database (Neon serverless Postgres) -------------------------------------
# Create a project at https://neon.tech (or via the Vercel Neon integration),
# then copy the pooled connection string here. It looks like:
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=

# --- Ingestion API auth -------------------------------------------------------
# Shared secret required to POST new events to /api/ingest.
# Generate one with: openssl rand -hex 32
INGEST_TOKEN=

# --- App config ---------------------------------------------------------------
# Default timezone used when an event doesn't specify one.
DEFAULT_TIMEZONE=Europe/Madrid
# Default city used when an event doesn't specify one.
DEFAULT_CITY=Burgos
# Public base URL (used to build absolute .ics / calendar links). Optional locally.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
